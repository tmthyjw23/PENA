APP_ENV=local
# Alamat aplikasi. XAMPP: http://localhost/pena. Server dev (composer serve) mengatur alamatnya sendiri.
APP_URL=http://localhost/pena

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pena
DB_USER=root
DB_PASSWORD=
ALLOW_DB_SETUP=false

# Menit tanpa aktivitas sebelum sesi masuk berakhir.
SESSION_IDLE_MINUTES=60

# AI lewat 9router (OpenAI-compatible). Kunci diambil dari dashboard 9router; model = id model atau nama combo.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=ag/gemini-3.8-flash-medium
AI_TIMEOUT=60
