APP_ENV=local
# Alamat aplikasi. XAMPP: http://localhost/pena. Server dev (composer serve) mengatur alamatnya sendiri.
APP_URL=http://localhost/pena

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pena
DB_USER=root
DB_PASSWORD=
ALLOW_DB_SETUP=false

# Menit tanpa aktivitas sebelum sesi masuk berakhir.
SESSION_IDLE_MINUTES=60

# AI lewat 9router (OpenAI-compatible). Kunci diambil dari dashboard 9router; model = id model atau nama combo.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=ag/gemini-3.8-flash-medium
AI_TIMEOUT=60

# Batas panggilan AI per jam; setiap retry ikut dihitung.
AI_MAX_TOKENS=1500
AI_USER_HOURLY_LIMIT=60
AI_WORKSPACE_HOURLY_LIMIT=120
AI_PLATFORM_HOURLY_LIMIT=200
SOFFICE_BINARY=/usr/bin/libreoffice

# Email akun: kunci hanya di server, tidak di frontend/Git. APP_URL wajib eksplisit.
RESEND_API_KEY=
MAIL_FROM="PENA <noreply@notify.egg3l.com>"

# Batas output untuk rancangan dan isi surat pribadi dinamis; surat organisasi memakai AI_MAX_TOKENS.
AI_PERSONAL_MAX_TOKENS=3000

# Base64 of 32 random bytes; keep private, outside Git. Back up separately from the DB.
# Required only for saved personal AI keys. Never replace while encrypted keys exist.
AI_CREDENTIAL_KEY=
# Alternative: absolute path to a private file containing the base64 key (outside web/release root).
AI_CREDENTIAL_KEY_FILE=
